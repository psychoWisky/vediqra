# API base URL. Leave EMPTY: the app calls /api/... and Vite (dev) / nginx (prod) proxy it to the backend.
VITE_API_URL=
# Optional fallback only; the server returns the Razorpay public key id itself.
# VITE_RAZORPAY_KEY_ID=

# Brand contact/social details shown in the footer and support links. All optional — unset ones simply
# don't render (see src/config/brand.ts). Nothing here has a hardcoded fallback.
# VITE_SUPPORT_EMAIL=
# VITE_SUPPORT_PHONE=
# VITE_WEBSITE_URL=
# VITE_SOCIAL_INSTAGRAM=
# VITE_SOCIAL_FACEBOOK=
# VITE_SOCIAL_YOUTUBE=
# VITE_SOCIAL_X=

# Meta (Facebook) Pixel ID. Leave empty to disable analytics entirely — no pixel script is ever
# injected and no tracking request is made until this is set (see src/utils/metaPixel.ts).
# VITE_META_PIXEL_ID=
