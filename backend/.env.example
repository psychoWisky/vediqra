# Copy to .env and fill in. Never commit real values.
PORT=5000
NODE_ENV=production

# PostgreSQL (DB_SSL defaults to true in production, false otherwise)
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=vediqra
# DB_SSL=true

# Admin auth: REQUIRED. Random string, at least 32 chars.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# JWT_EXPIRES_IN=8h

# Comma separated storefront origins allowed to call the API (recommended in production)
# CORS_ORIGINS=https://www.example.com
# Number of reverse proxies in front of the API (nginx = 1) so rate limits use real client IPs
# TRUST_PROXY=1

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
EMAIL_USER=
EMAIL_PASSWORD=

# Brand identity used in emails, invoices and admin notifications.
# BRAND_NAME=VEDIQRA
# Where customer-facing admin notifications (new order, etc.) are sent. Falls back to EMAIL_USER if unset.
# SUPPORT_EMAIL=
# SUPPORT_PHONE=
# WEBSITE_URL=https://www.example.com

# Absolute base URL this server is reachable at, used to build public URLs for uploaded files
# (e.g. https://api.example.com). Leave empty to derive from the incoming request automatically —
# works for local dev and most single-domain deployments without any configuration.
# PUBLIC_BASE_URL=

# Pricing rules (defaults shown)
# ORDER_ID_PREFIX=VEDIQRA
# FREE_SHIPPING_THRESHOLD=499
# SHIPPING_FEE=79
# COD_FEE=49
