# Copy to .env and fill in. Never commit real values.
PORT=5000
NODE_ENV=production

# PostgreSQL (DB_SSL defaults to true in production, false otherwise)
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=vediqra
# DB_SSL=true

# Admin auth: REQUIRED. Random string, at least 32 chars.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# JWT_EXPIRES_IN=8h

# Comma separated storefront origins allowed to call the API (recommended in production)
# CORS_ORIGINS=https://www.example.com
# Which proxies Express believes about the real client IP (every rate limiter uses it). With nginx on the SAME host use
# `loopback`. Also accepted: 0 (trust nobody, the default), a hop count 1-3, or a comma separated list of proxy IPs/CIDRs.
# `true` is refused. Nginx must set X-Forwarded-For (see docs/DEPLOYMENT.md), and the API should listen only on 127.0.0.1.
# TRUST_PROXY=loopback
# LISTEN_HOST=127.0.0.1

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
EMAIL_USER=
EMAIL_PASSWORD=

# Brand identity used in emails, invoices and admin notifications.
# BRAND_NAME=VEDIQRA
# Where customer-facing admin notifications (new order, etc.) are sent. Falls back to EMAIL_USER if unset.
# SUPPORT_EMAIL=
# SUPPORT_PHONE=
# WEBSITE_URL=https://www.example.com

# Absolute base URL this server is reachable at, used to build public URLs for uploaded files
# (e.g. https://api.example.com). Leave empty to derive from the incoming request automatically —
# works for local dev and most single-domain deployments without any configuration.
# PUBLIC_BASE_URL=

# Pricing rules (defaults shown)
# ORDER_ID_PREFIX=VEDIQRA
# FREE_SHIPPING_THRESHOLD=499
# SHIPPING_FEE=79

# ---- Payment recovery (see docs/PAYMENT_RECOVERY.md; nothing here is a secret value) ----
# Webhook signing secret. Set it on the Razorpay dashboard webhook; it is NOT the API key secret. Test and live
# mode have different webhooks and secrets.
# RAZORPAY_WEBHOOK_SECRET=
# Only while rotating the secret: the old one, for verifying retries of events signed before the change.
# RAZORPAY_WEBHOOK_SECRET_PREVIOUS=
# Deadline for each direct Razorpay API call, in ms (1000-60000).
# RAZORPAY_TIMEOUT_MS=10000
# Leave unset in production (defaults to https://api.razorpay.com). Tests point it at a local stub.
# RAZORPAY_API_BASE=
# Background recovery job: off unless true (needs RAZORPAY_KEY_ID/SECRET). Turn it on in production.
# PAYMENT_RECOVERY_ENABLED=false
# PAYMENT_RECOVERY_INTERVAL_MS=60000
# One-time bridge for Razorpay orders created before payment intents existed. Leave BOTH unset (disabled).
# Set only at the deployment that introduces intents: INTENTS_ENABLED_AT = deployment time (ISO, UTC) and
# LEGACY_VERIFY_UNTIL = at most 24 hours later. The server refuses to start with a longer window.
# INTENTS_ENABLED_AT=
# LEGACY_VERIFY_UNTIL=
# Webhook abuse protection (per application process; see docs/PAYMENT_RECOVERY.md).
# RATE_LIMIT_WEBHOOK=300          requests per minute per IP before 429
# WEBHOOK_MAX_CONCURRENT=25       events processed at once before 503 + Retry-After

# ---- Test-mode safety guard (OPT-IN; off by default, normal deployments are unaffected) ----
# When true the API (and `npm run migrate`) refuse to start unless RAZORPAY_KEY_ID starts with rzp_test_ and DB_NAME matches
# vediqra_test_<name> (or is listed below). The real database name "vediqra" is always refused. Must be exactly true or false.
# PAYMENT_TEST_MODE_GUARD=true
# TEST_MODE_ALLOWED_DB_NAMES=vediqra_staging_test
